# postinst -- create the system user the server becomes, the state directory, and enable the
# unit.
#
# It starts the service, but it does not build the index. The server no longer needs a
# snapshot to run (design D11): it comes up on whatever the snapshot holds, or on an empty
# index when there is none, and compares /etc/esidx/roots with the locations that covers --
# rebuilding in a child process, as the identity it drops to, whenever the two disagree. So
# the first scan is not this script's job, and it must not be: 60s on a workstation's /work,
# a minute and a half on /usr, with no tty, dpkg's own timeouts and a failed install halfway
# through a scan. The service answers from an empty index while that runs, which is a state
# it can report, unlike a half-configured install.

set -e

DEFAULTCFG=/etc/default/esidx
ROOTSF=/etc/esidx/roots
VARLIB=/var/lib/esidx
UNITDIR=/usr/lib/systemd/system

# The user and group are hardcoded rather than read from the config file, and the unit names
# them literally (see the note in esidx.service): one name, in two places that must agree
# (this script creates it, the unit's --drop-to= names it), and no second place for an admin
# to change one of them.
SYSUSER=esidx
SYSGROUP=esidx

die() { echo "esidx: $*" >&2; exit 1; }

# Read one KEY=value out of the environment file as data. Sourcing it would be one line and
# would also run whatever else the admin has put in it, with set -e and root.
read_kv() {
    [ -f "$DEFAULTCFG" ] || return 0
    sed -n "s/^[[:space:]]*$1=\(.*\)$/\1/p" "$DEFAULTCFG" | tail -1
}

# The indexed locations, one per line, from the roots file. Read as data for the same reason
# read_kv() reads a KEY=value: sourcing it would run whatever else an admin has put there,
# as root, from a maintainer script. Blank lines and '#' comments are dropped because the
# file's own documentation promises they are.
read_roots() {
    [ -f "$ROOTSF" ] || return 0
    sed -e 's/#.*$//' -e 's/[[:space:]]*$//' -e 's/^[[:space:]]*//' "$ROOTSF" \
        | grep -v '^$'
}

case "$1" in
    configure)
        # 0. Retire the two-unit deployment this package used to install (esidx-proxy +
        #    esidx-index). dpkg removes the unit *files* on upgrade because they are no longer
        #    shipped, but it does not touch the enable symlinks postinst created, and a
        #    symlink to a unit that no longer exists is a boot-time warning nobody asked for.
        #    The former pair is stopped as well: a proxy still running from the old package
        #    would hold a second fanotify mark on the same tree, which is not an error, just
        #    an event delivered twice to a server that is now its own proxy.
        OLD="esidx-proxy.service esidx-index.service"
        if [ -d /run/systemd/system ]; then
            systemctl stop $OLD >/dev/null 2>&1 || true
            systemctl disable $OLD >/dev/null 2>&1 || true
        fi
        for u in $OLD; do
            rm -f "/etc/systemd/system/multi-user.target.wants/$u"
        done

        # 1. the user and group. The user is what the server becomes once the fanotify group
        #    is open (--drop-to=), and it owns the snapshot; the group is what shares the state
        #    directory between the three identities that write there, and what the unit runs in
        #    before it drops (Group=esidx, see the unit).
        if ! getent group "$SYSGROUP" >/dev/null 2>&1; then
            addgroup --system "$SYSGROUP" >/dev/null 2>&1 \
                || die "cannot create group $SYSGROUP"
        fi
        if ! getent passwd "$SYSUSER" >/dev/null 2>&1; then
            adduser --system --ingroup "$SYSGROUP" --no-create-home \
                    --home "$VARLIB" --shell /usr/sbin/nologin \
                    --gecos "esidx index server" "$SYSUSER" >/dev/null 2>&1 \
                || die "cannot create user $SYSUSER"
        fi

        # 1b. who the server will become, read here rather than at the end: it decides the group
        #     membership below, and reading a variable after the thing it configures is how a
        #     script ends up arranging one deployment and describing another.
        svc=$(read_kv ESIDX_USER)
        [ -n "$svc" ] || svc=$SYSUSER

        # 2. the state directory: the snapshot and the lock file live here. It is owned by the
        #    dedicated user and shared with the dedicated group -- 2775, not 0755 -- because
        #    three identities write here and only one of them is that user:
        #      - the unit's process *before* it gives the privilege back. Its capability set
        #        does not include CAP_DAC_OVERRIDE, so uid 0 is "other" as far as file modes are
        #        concerned: it may create the lock file here only by belonging to the group that
        #        owns the directory (Group=esidx). With the old 0755 the lock could not be
        #        created at all and the service died with "cannot open the lock file" instead of
        #        starting -- measured on r7000, immediately after the lock was added.
        #      - the user the server becomes (ESIDX_USER), which rewrites the snapshot when
        #        --save is on; it is put in this group below.
        #      - the admin who runs `esidx build -o ...` and inspects the result: the invoking
        #        user is put in this group below too.
        #    setgid, so whatever any of the three creates keeps the group instead of becoming
        #    writable by one of them and inaccessible to the other two.
        install -d -o "$SYSUSER" -g "$SYSGROUP" -m 2775 "$VARLIB"

        # 2b. group membership for the two identities above that are not the dedicated user.
        #     The package does this rather than printing instructions, because a deployment that
        #     needs an admin to remember two usermod calls is one that gets half-arranged -- and
        #     the half that is missing here is the half that can write the state directory.
        if [ "$svc" != "$SYSUSER" ] && getent passwd "$svc" >/dev/null 2>&1; then
            if ! id -nG "$svc" 2>/dev/null | tr ' ' '\n' | grep -qx "$SYSGROUP"; then
                usermod -aG "$SYSGROUP" "$svc" || die "cannot add $svc to $SYSGROUP"
                echo "esidx: ESIDX_USER=$svc added to $SYSGROUP, so it can write $VARLIB." >&2
            fi
        fi
        # The user who installed it is not part of the privilege boundary -- it runs no part of
        # the service -- but it is the identity that builds snapshots into $VARLIB by hand.
        if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ] && [ "$SUDO_USER" != "$SYSUSER" ]; then
            if ! id -nG "$SUDO_USER" 2>/dev/null | tr ' ' '\n' | grep -qx "$SYSGROUP"; then
                if usermod -aG "$SYSGROUP" "$SUDO_USER" 2>/dev/null; then
                    echo "esidx: $SUDO_USER added to $SYSGROUP, so $VARLIB is reachable from" >&2
                    echo "       that account as well (log out and back in for it to apply)." >&2
                else
                    echo "esidx: could not add $SUDO_USER to $SYSGROUP; add it by hand to work" >&2
                    echo "       in $VARLIB." >&2
                fi
            fi
        fi

        # 3. A unit in /etc/systemd/system overrides the packaged one in /usr/lib. That is
        #    systemd's design and it is correct for an admin who means it -- but it is also
        #    the shape in which an install "succeeds" and the packaged unit never runs, and
        #    the only symptom is a service configured the way it was before. Moving it aside
        #    with a printed reason beats leaving a file that silently outranks the package.
        for u in esidx; do
            if [ -e "/etc/systemd/system/$u.service" ]; then
                mv -f "/etc/systemd/system/$u.service" \
                      "/etc/systemd/system/$u.service.removed-by-esidx-package"
                echo "esidx: /etc/systemd/system/$u.service existed and takes precedence over" >&2
                echo "       the packaged unit. It has been moved to $u.service.removed-by-esidx-package." >&2
            fi
        done

        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload >/dev/null 2>&1 || true
            systemctl enable esidx.service >/dev/null 2>&1 \
                || echo "esidx: could not enable the unit; enable it by hand." >&2
            # Cheap, and it turns a unit that cannot parse into an install-time message
            # instead of a boot-time one. Non-fatal: a warning here must not fail the install.
            #
            # Only lines that name this file are ours. verify() loads the unit *and everything
            # it depends on*, so its output can be about units this package has never heard of,
            # and those lines then look like they came from it: on the first r7000 install it
            # printed an unrelated nvidia ordering cycle, snapd's unknown key and a third-party
            # unit's mode bits, all under our name. A real problem with our unit is reported
            # with our unit's path, so filtering on the file name keeps the signal.
            if command -v systemd-analyze >/dev/null 2>&1; then
                systemd-analyze verify "$UNITDIR/esidx.service" 2>&1 \
                    | grep -F "esidx.service" \
                    | sed 's/^/esidx: /' >&2 || true
            fi
            # Start it, and on an upgrade restart it: an upgrade replaces the binary *under
            # a running service*, and systemd does not restart it for that -- Restart=always
            # is about the process exiting, not about the file changing -- so without this an
            # update installs cleanly and the old process keeps answering, which is the one
            # outcome an operator cannot see.
            #
            # Starting a first install is the other half, and it is safe now that the server
            # builds its own index (design D11): it comes up on whatever the snapshot holds,
            # or on an empty index when there is none, and reconciles the locations from
            # $ROOTSF in a child process. It used to be refused -- "the server needs a
            # snapshot" -- which is what made this script print a build command and leave the
            # service down until somebody ran it.
            if systemctl is-active --quiet esidx.service 2>/dev/null; then
                systemctl restart esidx.service >/dev/null 2>&1 || true
            else
                systemctl start esidx.service >/dev/null 2>&1 \
                    || echo "esidx: could not start the unit; start it by hand." >&2
            fi
        else
            echo "esidx: systemd is not running here; the unit was installed but not enabled." >&2
        fi

        # 4. say what is left to do, because "installed" and "answering queries" are not the
        #    same state and only one of them is true right now.
        db=$(read_kv ESIDX_DB)
        port=$(read_kv ESIDX_PORT)
        bind=$(read_kv ESIDX_BIND)
        # The locations, as a count and as a list. The count is what the message leads with,
        # because "one tree" and "four directories" are different statements about what is
        # about to be scanned and the reader cannot tell which from a path.
        nroots=$(read_roots | wc -l)
        roots=$(read_roots | tr '\n' ' ')
        # The index is built by the service, as the user that serves it ($svc, read in step
        # 1b) -- not as root, and not as the user this package created. That is the whole
        # reason nothing here builds one: the index is a view of what that identity may read,
        # and building it as anyone else quietly produces a smaller one, which the service
        # then answers as if the files were not there. Measured on r7000: 5 372 563 entries
        # as the service account against 5 476 485 as the deploying user, 1 407 directories
        # the difference. So a location that comes back emptier than expected is a question
        # about that account's permissions, not about this package.
        [ -n "$db" ] || db=$VARLIB/root.idx
        [ -n "$port" ] || port=2121
        [ -n "$bind" ] || bind=127.0.0.1
        [ -n "$svc" ] || svc=$SYSUSER

        # The version being installed, read back rather than taken from "$2": dpkg hands a
        # maintainer script the version it is *replacing*, so "$2" in these messages named the
        # one that was just thrown away -- measured on r7000, announcing 8904952-dirty while
        # installing 5abd055-dirty. During configure the status file already holds the new
        # version, which is what this reads.
        newver=$(dpkg-query -W -f='${Version}' esidx 2>/dev/null || true)
        [ -n "$newver" ] || newver=$2
        # Every location is checked, not just the first: a roots file naming four trees where
        # one is on a volume that is not mounted yet would otherwise be reported by the server
        # refusing to start, which is the same information delivered later and less usefully.
        for r in $roots; do
            [ -d "$r" ] || echo "esidx: warning: $ROOTSF names $r, which does not exist;" \
                              "the build below will fail on it" >&2
        done
        # Not an error, and not worth refusing over: the service starts anyway and serves an
        # empty index until this file names something, which is the state a fresh install is
        # in before anybody has edited it.
        [ "$nroots" -gt 0 ] || echo "esidx: warning: $ROOTSF names no locations; the service" \
                              "will start with an empty index until it does" >&2

        if systemctl is-active --quiet esidx.service 2>/dev/null; then
            # Nothing to run afterwards, and saying so is the point of this message: the
            # deployment used to end with a build command the operator had to type, and an
            # install that ends with instructions is an install that is half done. What the
            # operator still has to know is *where* the locations are named -- that file is
            # the whole of the configuration they will ever touch -- and that the scan is
            # happening now, in the background, as $svc.
            cat <<EOF

esidx $newver installed and running. The locations are $ROOTSF -- $nroots of them right now:
$roots

The index is built by the service itself, as $svc, in a child process: it has compared that
file with what the snapshot covers and is rebuilding wherever they disagree, and it will do
the same again every time you edit the file. There is no build command, before an install or
after one, and a client is answered throughout.

An ETP client (Everything) can connect to $bind:$port. The rest of the configuration is
$DEFAULTCFG, and unlike the locations file a change there needs a restart:

  systemctl status esidx
  journalctl -u esidx -f

EOF
        else
            cat <<EOF

esidx $newver installed. The unit is enabled but it is not running: this script could not
start it (see the message above). Start it, and it will build the index itself from the
$nroots location(s) in $ROOTSF: $roots

  sudo systemctl start esidx

then an ETP client (Everything) can connect to $bind:$port. Editing $ROOTSF adds or removes
a location without a restart -- the rebuild runs in a child process and the server keeps
answering. The rest of the configuration is $DEFAULTCFG; logs are in the journal:

  journalctl -u esidx -f

EOF
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0